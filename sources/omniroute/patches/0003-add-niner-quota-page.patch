+                      <span className={`material-symbols-outlined text-[18px] text-text-muted ${isLoading ? "animate-spin" : ""}`}>refresh</span>
+                    </button>
+                    <div className="inline-flex items-center pl-0.5" title={(conn.isActive ?? true) ? "Disable connection" : "Enable connection"}>
+                      <Toggle size="sm" checked={conn.isActive ?? true} disabled={busy} onChange={(v) => handleToggleConnectionActive(conn.id, v)} />
