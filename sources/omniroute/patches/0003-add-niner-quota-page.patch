+        fetchConnections(),
+        fetch("/api/usage/provider-limits")
+          .then((r) => (r.ok ? r.json() : {}))
+          .then((d) => d.caches || {})
+          .catch(() => ({})),
+      ]);
+      applyCachedQuotaState(connectionList, caches);
