+import { Suspense } from "react";
+import { CardSkeleton } from "@/shared/components";
+import NinerQuotaDashboard from "../usage/components/NinerQuota";
+
+export default function NinerQuotaPage() {
+  return (
+    <Suspense fallback={<CardSkeleton />}>
+      <NinerQuotaDashboard />
+    </Suspense>
+  );
+}
