+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-session-warmup-"));
+process.env.DATA_DIR = TEST_DATA_DIR;
+
+type FetchStub = (
+  input: string | URL | Request,
+  init?: RequestInit
+) => Promise<Response> | Response;
+
+let currentFetchStub: FetchStub | null = null;
+
+const realFetch = globalThis.fetch;
+
+function stubFetch(stub: FetchStub) {
+  currentFetchStub = stub;
+}
+
+function restoreFetch() {
+  currentFetchStub = null;
+}
+
+globalThis.fetch = ((input: any, init?: any) => {
+  if (currentFetchStub) return currentFetchStub(input, init);
+  return realFetch(input, init);
+}) as typeof fetch;
+
+const core = await import("../../src/lib/db/core.ts");
+const providersDb = await import("../../src/lib/db/providers.ts");
+const bailianQuota = await import("../../open-sse/services/bailianQuotaFetcher.ts");
+
+const warmup = await import("../../src/lib/sessionWarmupJob.ts");
+
+async function resetStorage() {
+  core.resetDbInstance();
+
+  for (let attempt = 0; attempt < 10; attempt++) {
+    try {
+      if (fs.existsSync(TEST_DATA_DIR)) {
+        fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+      }
+      break;
+    } catch (error: any) {
+      if ((error?.code === "EBUSY" || error?.code === "EPERM") && attempt < 9) {
+        await new Promise((resolve) => setTimeout(resolve, 50 * (attempt + 1)));
+      } else {
+        throw error;
+      }
+    }
+  }
+
+  fs.mkdirSync(TEST_DATA_DIR, { recursive: true });
+}
+
+interface QuotaPayload {
+  percentUsed: number;
+  resetAt: string | null;
+  window5h: { percentUsed: number; resetAt: string | null };
+  windowWeekly: { percentUsed: number; resetAt: string | null };
+  windowMonthly: { percentUsed: number; resetAt: string | null };
+  used: number;
+  total: number;
+}
+
+function buildQuota(opts: {
+  reset5h?: string | null;
+  pct5h?: number;
+  resetWeekly?: string | null;
+  pctWeekly?: number;
+  pctMonthly?: number;
+}): QuotaPayload {
+  const pct5h = opts.pct5h ?? 0;
+  const pctWeekly = opts.pctWeekly ?? 0;
+  const pctMonthly = opts.pctMonthly ?? 0;
+  const worst = Math.max(pct5h, pctWeekly, pctMonthly);
+  return {
+    percentUsed: worst,
+    resetAt: opts.reset5h ?? null,
+    used: Math.round(worst * 100),
+    total: 100,
+    window5h: { percentUsed: pct5h, resetAt: opts.reset5h ?? null },
+    windowWeekly: { percentUsed: pctWeekly, resetAt: opts.resetWeekly ?? null },
+    windowMonthly: {
+      percentUsed: pctMonthly,
+      resetAt: opts.reset5h ?? null,
+    },
+  };
+}
+
+async function createConnection(overrides: Record<string, unknown> = {}) {
+  const conn = await providersDb.createProviderConnection({
+    provider: "bailian-coding-plan",
+    authType: "apikey",
+    name: "Bailian Test",
+    apiKey: "test-api-key",
+    isActive: true,
+    defaultModel: "qwen3-coder-plus",
+    providerSpecificData: {
+      sessionWarmupEnabled: true,
+      ...overrides,
+    },
+  });
+  return conn as Record<string, unknown>;
+}
+
+function okJsonResponse(body: unknown): Response {
+  return new Response(JSON.stringify(body), {
+    status: 200,
+    headers: { "Content-Type": "application/json" },
+  });
+}
+
+function bailianQuotaResponse(opts: {
+  used5h?: number;
+  total5h?: number;
+  reset5h?: number;
+  usedWeekly?: number;
+  totalWeekly?: number;
+  resetWeekly?: number;
+}) {
+  return {
+    code: "Success",
+    data: {
