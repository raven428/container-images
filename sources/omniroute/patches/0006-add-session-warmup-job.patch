index 00000000..ac4be8d1
--- /dev/null
+++ b/src/lib/sessionWarmupJob.ts
@@ -0,0 +1,667 @@
+/**
+ * Session Warmup Job
+ *
+ * Background job that periodically checks connections whose 5h quota window
+ * has NOT yet been opened (session.resetAt === null) and sends a lightweight
+ * request to start the window.
+ *
+ * Supported providers:
+ *   - claude               (Anthropic OAuth, executor pipeline)
+ *   - glm / glm-cn / zai / glmt  (Z.AI / bigmodel.cn OpenAI-compatible)
+ *
+ * Quota data uses the SAME DB cache as /dashboard/niner-quota
+ * (providerLimitsCache).  All reads/writes go through
+ * getProviderLimitsCache / fetchAndPersistProviderLimits.
+ *
+ * Toggle: per-connection `provider_specific_data.sessionWarmupEnabled: boolean`.
+ */
+
+import {
+  getProviderConnections,
+  resolveProxyForConnection,
+  updateProviderConnection,
+} from "@/lib/localDb";
+import { pickMaskedDisplayValue } from "@/shared/utils/maskEmail";
+import { getProviderLimitsCache } from "@/lib/db/providerLimits";
+import { runWithProxyContext } from "@omniroute/open-sse/utils/proxyFetch.ts";
+import { fetchAndPersistProviderLimits } from "@/lib/usage/providerLimits";
+import { getExecutor } from "@omniroute/open-sse/executors/index.ts";
+import {
+  GLM_DEFAULT_BASE_URLS,
+  getGlmApiRegion,
+} from "@omniroute/open-sse/config/glmProvider";
+
+// ── Constants ────────────────────────────────────────────────────────────────
+
+const SWEEP_INTERVAL_MS = 60 * 1000;
+const SWEEP_INITIAL_DELAY_MS = 15_000;
+const SWEEP_STAGGER_MS = 2_000;
+
+const WARMUP_TTL_MS = 60 * 60 * 1000;
+const FETCH_FAILURE_BACKOFF_MS = 5 * 60 * 1000;
+const FETCH_TIMEOUT_MS = 8_000;
+const WARMUP_BACKOFF_STEP_MS = 60 * 1000;
+const WARMUP_BACKOFF_MAX_STEPS = 5;
+const WARMUP_BACKOFF_RESET_AFTER = 6;
+const SESSION_END_JITTER_MIN_MS = 3 * 60 * 1000;
+const SESSION_END_JITTER_RANGE_MS = 12 * 60 * 1000;
+
+const GLM_PROVIDER_IDS = new Set(["glm", "glm-cn", "zai", "glmt"]);
+const GLM_WARMUP_MODEL_FALLBACK = "glm-5";
+
+const CLAUDE_PROVIDER = "claude";
+const CLAUDE_WARMUP_MODEL_FALLBACK = "claude-haiku-4-5-20251001";
+
+const ALL_TARGET_PROVIDERS = [CLAUDE_PROVIDER, ...GLM_PROVIDER_IDS];
+
+const LOG_PREFIX = "[SessionWarmup]";
+
+const WARMUP_PROBES: ReadonlyArray<{ role: "user"; content: string }> = [
+  { role: "user", content: "ok" },
+  {
+    role: "user",
+    content:
+      "Write a function that adds two numbers. Reply with just the function.",
+  },
+  { role: "user", content: "What is 17 * 23? Reply with just the number." },
+];
+
+// ── State ────────────────────────────────────────────────────────────────────
+
+interface InMemoryState {
+  fetchCooldownUntil: number;
+  knownSessionResetAt: number;
+  warmupFailureCount: number;
+  warmupBackoffUntil: number;
+  sessionEndSnoozeUntil: number;
+}
+
+const inMemoryState = new Map<string, InMemoryState>();
+
+// ── Singleton guard (globalThis survives HMR re-evaluation) ─────────────────
+
+declare global {
+  var __omnirouteSessionWarmup:
+    | {
+        initialized: boolean;
+        interval: ReturnType<typeof setInterval> | null;
+        initialTimer: ReturnType<typeof setTimeout> | null;
+      }
+    | undefined;
+}
+
+function getState() {
+  if (!globalThis.__omnirouteSessionWarmup) {
+    globalThis.__omnirouteSessionWarmup = {
+      initialized: false,
+      interval: null,
+      initialTimer: null,
+    };
+  }
+  return globalThis.__omnirouteSessionWarmup;
+}
+
+function isBuildProcess(): boolean {
+  return (
+    typeof process !== "undefined" &&
+    process.env.NEXT_PHASE === "phase-production-build"
+  );
+}
+
+function isAutomatedTestProcess(): boolean {
+  return (
+    typeof process !== "undefined" &&
+    (process.env.NODE_ENV === "test" ||
+      process.env.VITEST !== undefined ||
+      process.argv.some((arg) => arg.includes("test")))
+  );
+}
+
+function isDisabled(): boolean {
+  return isBuildProcess() || isAutomatedTestProcess();
+}
+
+// ── Public API ───────────────────────────────────────────────────────────────
+
+export function startSessionWarmupJob(): void {
+  const state = getState();
+  if (state.initialized || isDisabled()) return;
+  state.initialized = true;
+
+  console.log(
+    `${LOG_PREFIX} Starting (sweep every ${SWEEP_INTERVAL_MS / 1000}s, providers: ${ALL_TARGET_PROVIDERS.join(", ")})`
+  );
+
+  state.initialTimer = setTimeout(() => {
+    state.initialTimer = null;
+    void sweep();
+    state.interval = setInterval(() => {
+      void sweep();
+    }, SWEEP_INTERVAL_MS);
+    if (state.interval && typeof state.interval === "object" && "unref" in state.interval) {
+      (state.interval as { unref?: () => void }).unref?.();
+    }
+  }, SWEEP_INITIAL_DELAY_MS);
+  if (
+    state.initialTimer &&
+    typeof state.initialTimer === "object" &&
+    "unref" in state.initialTimer
+  ) {
+    (state.initialTimer as { unref?: () => void }).unref?.();
+  }
+}
+
+export function stopSessionWarmupJob(): void {
+  const state = getState();
+  if (state.initialTimer) {
+    clearTimeout(state.initialTimer);
+    state.initialTimer = null;
+  }
+  if (state.interval) {
+    clearInterval(state.interval);
+    state.interval = null;
+  }
+  state.initialized = false;
+}
+
+export function _resetSessionWarmupState(): void {
+  inMemoryState.clear();
+}
+
+// ── Helpers ──────────────────────────────────────────────────────────────────
+
+function getConnectionLabel(conn: {
+  name?: string;
+  email?: string;
+  id?: string;
+}): string {
+  return pickMaskedDisplayValue([conn.name, conn.email], conn.id || "-");
+}
+
+function asRecord(value: unknown): Record<string, unknown> {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+}
+
+function isWarmupEnabled(conn: Record<string, unknown>): boolean {
+  const psd = asRecord(conn.providerSpecificData);
+  return psd.sessionWarmupEnabled === true;
+}
+
+function getLastWarmupAt(conn: Record<string, unknown>): number {
+  const psd = asRecord(conn.providerSpecificData);
+  const raw = psd.lastSessionWarmupAt;
+  if (typeof raw !== "string" && typeof raw !== "number") return 0;
+  const ms = typeof raw === "number" ? raw : Date.parse(raw);
+  return Number.isFinite(ms) ? ms : 0;
+}
+
+async function persistLastWarmupAt(
+  connectionId: string,
+  timestampMs: number
+): Promise<void> {
+  try {
+    const existing = await getProviderConnectionByIdMinimal(connectionId);
+    if (!existing) return;
+    const psd = asRecord(existing.providerSpecificData);
+    await updateProviderConnection(connectionId, {
+      providerSpecificData: {
+        ...psd,
+        lastSessionWarmupAt: new Date(timestampMs).toISOString(),
+      },
+    });
+  } catch (err) {
+    console.warn(
+      `${LOG_PREFIX} Failed to persist lastSessionWarmupAt for ${connectionId}:`,
+      err instanceof Error ? err.message : String(err)
+    );
+  }
+}
+
+async function getProviderConnectionByIdMinimal(id: string) {
+  const { getProviderConnectionById } = await import("@/lib/localDb");
+  return getProviderConnectionById(id);
+}
+
+function pickRandomProbe(): { role: "user"; content: string } {
+  return WARMUP_PROBES[Math.floor(Math.random() * WARMUP_PROBES.length)];
+}
+
+function isGlmProvider(provider: unknown): boolean {
+  return typeof provider === "string" && GLM_PROVIDER_IDS.has(provider);
+}
+
+function isClaudeProvider(provider: unknown): boolean {
+  return provider === CLAUDE_PROVIDER;
+}
+
+// ── Quota reading/writing via providerLimitsCache (DB, same as NinerQuota) ───
+
+function readResetAtFromCache(
+  connectionId: string,
+  provider: string
+): string | null {
+  const dbCache = getProviderLimitsCache(connectionId);
+  if (!dbCache?.quotas) return null;
+
+  const sessionKey = isClaudeProvider(provider)
+    ? "session (5h)"
+    : "session";
+
+  const windowData = asRecord(dbCache.quotas[sessionKey]);
+  if (!windowData) return null;
+
+  return typeof windowData.resetAt === "string" ? windowData.resetAt : null;
+}
+
+async function refreshCache(
+  connectionId: string
+): Promise<string | null> {
+  try {
+    const result = await fetchAndPersistProviderLimits(connectionId, "manual");
+    const usage = result.usage as Record<string, unknown>;
+    const quotas = asRecord(usage?.quotas);
+    const session = quotas["session (5h)"] || quotas["session"];
+    if (session && typeof session === "object") {
+      return (session as Record<string, unknown>).resetAt as string | null;
+    }
+    return null;
+  } catch {
+    return null;
+  }
+}
+
+async function getSessionResetAt(
+  connectionId: string,
+  provider: string
+): Promise<string | null> {
+  const cached = readResetAtFromCache(connectionId, provider);
+  if (cached !== null) {
+    const resetMs = Date.parse(cached);
+    if (Number.isFinite(resetMs) && resetMs > Date.now()) {
+      return cached;
+    }
+  }
+
+  return refreshCache(connectionId);
+}
+
+// ── Warmup request ───────────────────────────────────────────────────────────
+
+interface WarmupOutcome {
+  success: boolean;
+  status?: number;
+  latencyMs: number;
+  snippet?: string;
+}
+
+function getWarmupModel(conn: Record<string, unknown>): string {
+  const provider = typeof conn.provider === "string" ? conn.provider : "";
+  const model = typeof conn.defaultModel === "string" ? conn.defaultModel.trim() : "";
+  if (model) return model;
+  if (isClaudeProvider(provider)) return CLAUDE_WARMUP_MODEL_FALLBACK;
+  return GLM_WARMUP_MODEL_FALLBACK;
+}
+
+async function sendWarmupRequest(
+  conn: Record<string, unknown>
+): Promise<WarmupOutcome> {
+  const provider = typeof conn.provider === "string" ? conn.provider : "";
+
+  if (isClaudeProvider(provider)) {
+    return sendClaudeWarmupRequest(conn);
+  }
+
+  const apiKey = typeof conn.apiKey === "string" ? conn.apiKey : "";
+  if (!apiKey) {
+    return { success: false, latencyMs: 0, snippet: "missing api_key on connection" };
+  }
+
+  const model = getWarmupModel(conn);
+  const probe = pickRandomProbe();
+
+  if (isGlmProvider(provider)) {
+    return sendGlmWarmupRequest(conn, apiKey, model, probe);
+  }
+
+  return { success: false, latencyMs: 0, snippet: `unsupported provider: ${provider}` };
+}
+
+async function sendClaudeWarmupRequest(
+  conn: Record<string, unknown>
+): Promise<WarmupOutcome> {
+  const accessToken = typeof conn.accessToken === "string" ? conn.accessToken : "";
+  if (!accessToken) {
+    return { success: false, latencyMs: 0, snippet: "missing access_token on connection" };
+  }
+
+  const model = getWarmupModel(conn);
+  const psd = asRecord(conn.providerSpecificData);
+  const testModelId =
+    typeof psd.validationModelId === "string" ? psd.validationModelId : model;
+
+  const startedAt = Date.now();
+  try {
+    const { response } = await getExecutor("claude").execute({
+      model: testModelId,
+      body: {
+        model: testModelId,
+        max_tokens: 1,
+        messages: [{ role: "user", content: "test" }],
+      },
+      stream: false,
+      credentials: { accessToken, providerSpecificData: psd },
+    });
+    const latencyMs = Date.now() - startedAt;
+    if (response.ok) return { success: true, status: response.status, latencyMs };
+    let snippet = "";
+    try {
+      snippet = (await response.text()).slice(0, 240);
+    } catch {}
+    return { success: false, status: response.status, latencyMs, snippet };
+  } catch (err) {
+    return {
+      success: false,
+      latencyMs: Date.now() - startedAt,
+      snippet: err instanceof Error ? err.message : String(err),
+    };
+  }
+}
+
+async function sendGlmWarmupRequest(
+  conn: Record<string, unknown>,
+  apiKey: string,
+  model: string,
+  probe: { role: "user"; content: string }
+): Promise<WarmupOutcome> {
+  const psd = asRecord(conn.providerSpecificData);
+  const region = getGlmApiRegion(psd);
+  const baseUrl = GLM_DEFAULT_BASE_URLS[region] || GLM_DEFAULT_BASE_URLS.international;
+
+  const url = `${baseUrl.replace(/\/$/, "")}`;
+  const headers: Record<string, string> = {
+    "Content-Type": "application/json",
+    Authorization: `Bearer ${apiKey}`,
+  };
+
+  const body = JSON.stringify({
+    model,
+    max_tokens: 1,
+    messages: [probe],
+  });
+
+  const startedAt = Date.now();
+  try {
+    const response = await fetch(url, {
+      method: "POST",
+      headers,
+      body,
+      signal: AbortSignal.timeout(FETCH_TIMEOUT_MS),
+    });
+    const latencyMs = Date.now() - startedAt;
+    if (response.ok) return { success: true, status: response.status, latencyMs };
+    let snippet = "";
+    try {
+      snippet = (await response.text()).slice(0, 240);
+    } catch {}
+    return { success: false, status: response.status, latencyMs, snippet };
+  } catch (err) {
+    return {
+      success: false,
+      latencyMs: Date.now() - startedAt,
+      snippet: err instanceof Error ? err.message : String(err),
+    };
+  }
+}
+
+// ── Core sweep ───────────────────────────────────────────────────────────────
+
+function fmtDuration(ms: number): string {
+  if (ms < 60_000) return `${Math.round(ms / 1000)}s`;
+  const totalMin = Math.floor(ms / 60_000);
+  if (totalMin < 60) return `${totalMin}m`;
+  const h = Math.floor(totalMin / 60);
+  const m = totalMin % 60;
+  return m > 0 ? `${h}h ${m}m` : `${h}h`;
+}
+
+function connTag(conn: Record<string, unknown>): string {
+  const provider = typeof conn.provider === "string" ? conn.provider : "?";
+  const label = getConnectionLabel(
+    conn as { name?: string; email?: string; id?: string }
+  );
+  return `${provider}/${label}`;
+}
+
+function warmupBackoffMs(failureCount: number): number {
+  const cycle = ((failureCount - 1) % WARMUP_BACKOFF_RESET_AFTER) + 1;
+  const step = Math.min(cycle, WARMUP_BACKOFF_MAX_STEPS);
+  return step * WARMUP_BACKOFF_STEP_MS;
+}
+
+function sessionEndJitter(): number {
+  return SESSION_END_JITTER_MIN_MS + Math.random() * SESSION_END_JITTER_RANGE_MS;
+}
+
+async function sweep(): Promise<void> {
+  for (const provider of ALL_TARGET_PROVIDERS) {
+    try {
+      const connections = (await getProviderConnections({
+        provider,
+        isActive: true,
+      })) as Record<string, unknown>[];
+
+      if (!connections.length) continue;
+
+      for (let i = 0; i < connections.length; i++) {
+        const conn = connections[i];
+        try {
+          await processConnection(conn);
+        } catch (err) {
+          console.error(
+            `${LOG_PREFIX} Per-connection error (${connTag(conn)}):`,
+            err instanceof Error ? err.message : String(err)
+          );
+        }
+
+        if (SWEEP_STAGGER_MS > 0 && i < connections.length - 1) {
+          await new Promise((resolve) => setTimeout(resolve, SWEEP_STAGGER_MS));
+        }
+      }
+    } catch (err) {
+      console.error(
+        `${LOG_PREFIX} Sweep: failed to load connections for ${provider}:`,
+        err instanceof Error ? err.message : String(err)
+      );
+    }
+  }
+}
+
+export async function processConnection(
+  conn: Record<string, unknown>
+): Promise<void> {
+  const connectionId = typeof conn.id === "string" ? conn.id : null;
+  if (!connectionId) return;
+  const provider = typeof conn.provider === "string" ? conn.provider : "";
+  const tag = connTag(conn);
+  const now = Date.now();
+
+  if (!isWarmupEnabled(conn)) {
+    return;
+  }
+
+  const mem = inMemoryState.get(connectionId);
+  if (mem && mem.fetchCooldownUntil > now) {
+    console.log(
+      `${LOG_PREFIX} Skipping ${tag} (fetch cooldown, ${fmtDuration(mem.fetchCooldownUntil - now)} left)`
+    );
+    return;
+  }
+
+  if (mem && mem.knownSessionResetAt > now) {
+    const peekResetAt = readResetAtFromCache(connectionId, provider);
+    if (peekResetAt) {
+      const peekMs = Date.parse(peekResetAt);
+      if (!Number.isFinite(peekMs) || peekMs <= now) {
+        const jitter = sessionEndJitter();
+        inMemoryState.set(connectionId, {
+          ...(mem || { fetchCooldownUntil: 0, knownSessionResetAt: 0, warmupFailureCount: 0, warmupBackoffUntil: 0, sessionEndSnoozeUntil: 0 }),
+          knownSessionResetAt: 0,
+          sessionEndSnoozeUntil: now + jitter,
+        });
+        console.log(
+          `${LOG_PREFIX} Session expired for ${tag} (cached resetAt ${peekResetAt}), snooze +${fmtDuration(jitter)} before warmup`
+        );
+        return;
+      } else {
+        const left = fmtDuration(peekMs - now);
+        console.log(
+          `${LOG_PREFIX} Skipping ${tag} (session active, ends ${peekResetAt}, ${left} left)`
+        );
+        return;
+      }
+    } else {
+      const left = fmtDuration(mem.knownSessionResetAt - now);
+      const endsAt = new Date(mem.knownSessionResetAt).toISOString();
+      console.log(
+        `${LOG_PREFIX} Skipping ${tag} (session active, ends ${endsAt}, ${left} left)`
+      );
+      return;
+    }
+  }
+
+  if (mem && mem.sessionEndSnoozeUntil > now) {
+    const left = fmtDuration(mem.sessionEndSnoozeUntil - now);
+    console.log(
+      `${LOG_PREFIX} Snoozing ${tag} (session ended, warmup in ${left})`
+    );
+    return;
+  }
+
+  if (mem && mem.warmupBackoffUntil > now) {
+    const left = fmtDuration(mem.warmupBackoffUntil - now);
+    console.log(
+      `${LOG_PREFIX} Skipping ${tag} (warmup backoff, ${left} left)`
+    );
+    return;
+  }
+
+  const lastWarmupAt = getLastWarmupAt(conn);
+  if (lastWarmupAt && now - lastWarmupAt < WARMUP_TTL_MS) {
+    const left = fmtDuration(WARMUP_TTL_MS - (now - lastWarmupAt));
+    const peekResetAt = readResetAtFromCache(connectionId, provider);
+    let sessionInfo = "";
+    if (peekResetAt) {
+      const peekMs = Date.parse(peekResetAt);
+      if (Number.isFinite(peekMs) && peekMs > now) {
+        sessionInfo = `, session ends ${peekResetAt}, ${fmtDuration(peekMs - now)} left`;
+      } else if (Number.isFinite(peekMs)) {
+        sessionInfo = ", session expired";
+      }
+    }
+    console.log(
+      `${LOG_PREFIX} Skipping ${tag} (warmup TTL, ${left} left${sessionInfo})`
+    );
+    return;
+  }
+
+  let sessionResetAt: string | null = null;
+  try {
+    sessionResetAt = await getSessionResetAt(connectionId, provider);
+  } catch (err) {
+    const cooldownUntil = Date.now() + FETCH_FAILURE_BACKOFF_MS;
+    inMemoryState.set(connectionId, {
+      ...inMemoryState.get(connectionId),
+      fetchCooldownUntil: cooldownUntil,
+    });
+    console.warn(
+      `${LOG_PREFIX} ! ${tag} quota read threw, cooldown ${FETCH_FAILURE_BACKOFF_MS / 1000}s`
+    );
+    return;
+  }
+
+  if (sessionResetAt) {
+    const resetAtMs = Date.parse(sessionResetAt);
+    if (Number.isFinite(resetAtMs) && resetAtMs > now) {
+      const snoozeUntil = resetAtMs + sessionEndJitter();
+      inMemoryState.set(connectionId, {
+        ...inMemoryState.get(connectionId),
+        knownSessionResetAt: snoozeUntil,
+        sessionEndSnoozeUntil: 0,
+      });
+    }
+    const left = Number.isFinite(resetAtMs) && resetAtMs > now
+      ? fmtDuration(resetAtMs - now)
+      : "?";
+    const endsAt = Number.isFinite(resetAtMs)
+      ? new Date(resetAtMs).toISOString()
+      : sessionResetAt;
+    console.log(
+      `${LOG_PREFIX} Skipping ${tag} (session active, ends ${endsAt}, ${left} left)`
+    );
+    return;
+  }
+
+  console.log(
+    `${LOG_PREFIX} Sending warmup to ${tag} (session not started)`
+  );
+
+  let outcome: WarmupOutcome;
+  try {
+    const proxyInfo = await resolveProxyForConnection(connectionId);
+    outcome = await runWithProxyContext(proxyInfo?.proxy || null, () =>
+      sendWarmupRequest(conn)
+    );
+  } catch (err) {
+    outcome = {
+      success: false,
+      latencyMs: 0,
+      snippet: err instanceof Error ? err.message : String(err),
+    };
+  }
+
+  if (outcome.success) {
+    const newResetAt = await refreshCache(connectionId);
+    let jitterInfo = "";
+    if (newResetAt) {
+      const newMs = Date.parse(newResetAt);
+      if (Number.isFinite(newMs) && newMs > Date.now()) {
+        const jitter = sessionEndJitter();
+        const snoozeUntil = newMs + jitter;
+        inMemoryState.set(connectionId, {
+          fetchCooldownUntil: 0,
+          knownSessionResetAt: snoozeUntil,
+          warmupFailureCount: 0,
+          warmupBackoffUntil: 0,
+          sessionEndSnoozeUntil: 0,
+        });
+        jitterInfo = `, session ends ${newResetAt}, snooze +${fmtDuration(jitter)}`;
+      }
+    }
+    if (!newResetAt) {
+      inMemoryState.delete(connectionId);
+    }
+    console.log(
+      `${LOG_PREFIX} ✓ ${tag} warmup OK (${outcome.latencyMs}ms${jitterInfo})`
+    );
+    await persistLastWarmupAt(connectionId, Date.now());
+  } else {
+    const prev = inMemoryState.get(connectionId);
+    const failureCount = (prev?.warmupFailureCount ?? 0) + 1;
+    const backoffMs = warmupBackoffMs(failureCount);
+    inMemoryState.set(connectionId, {
+      ...prev,
+      fetchCooldownUntil: 0,
+      knownSessionResetAt: 0,
+      warmupFailureCount: failureCount,
+      warmupBackoffUntil: Date.now() + backoffMs,
+      sessionEndSnoozeUntil: 0,
+    });
+    console.error(
+      `${LOG_PREFIX} ✗ ${tag} warmup failed (status=${outcome.status ?? "?"}, ${outcome.latencyMs}ms, retry in ${fmtDuration(backoffMs)}${outcome.snippet ? `, ${outcome.snippet.slice(0, 80)}` : ""})`
+    );
+  }
+}
+
+export default startSessionWarmupJob;
