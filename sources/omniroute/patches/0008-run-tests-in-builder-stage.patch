--- a/Dockerfile
+++ b/Dockerfile
@@ -19,6 +19,25 @@
 COPY . ./
 RUN mkdir -p /app/data && npm run build -- --webpack
 
+# Run the upstream test suites that work without external services or a live
+# server (unit + vitest). This executes inside the throwaway `builder` stage,
+# so nothing here is copied into `runner-base` and the final image stays clean.
+# A failing test aborts the build before any tags are produced.
+#
+# The invocation mirrors the upstream CI (.github/workflows/ci.yml, job
+# `test-unit`): serial execution (--test-concurrency=1) with the JWT/API-key
+# secrets and SQLite backup disabled. The default `npm run test:unit` uses
+# --test-concurrency=10 and no secrets, which lets a single test leaving an
+# open handle hang the whole runner forever (there is no CI `timeout-minutes`
+# wrapper here). --test-force-exit is added as a belt-and-suspenders guard so
+# the build fails fast instead of stalling on a dangling handle.
+ENV DISABLE_SQLITE_AUTO_BACKUP=true \
+  JWT_SECRET=ci-test-secret-with-sufficient-length-for-validation \
+  API_KEY_SECRET=ci-test-api-key-secret-long
+RUN node --import tsx --test --test-force-exit --test-concurrency=1 \
+  tests/unit/*.test.ts \
+  && npm run test:vitest
+
 FROM node:26.2.0-trixie-slim AS runner-base
 WORKDIR /app
 
