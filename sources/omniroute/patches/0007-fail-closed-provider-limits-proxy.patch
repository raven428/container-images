+/**
+ * When a per-connection proxy is configured but the proxy fails, the usage
+ * fetch used to silently retry WITHOUT the proxy — leaking the host's real IP
+ * to the upstream provider. That defeats the whole point of a fail-closed proxy
+ * setup and can also mask a dead proxy (the warmup job would then see a "live"
+ * resetAt fetched directly and never fire).
+ *
+ * Fail-closed is now the default: the direct-connection retry only happens when
+ * PROVIDER_LIMITS_PROXY_FALLBACK is explicitly set to "true".
+ */
+function isProxyFallbackEnabled(): boolean {
+  return process.env.PROVIDER_LIMITS_PROXY_FALLBACK === "true";
+}
