+// ─── TEMP diagnostic logging (patch 0111) ───────────────────────────────────
+// Logs every Codex HTTP exchange (request body + response status/body) while
+// the "warmup request visibility" investigation runs. Lives here so ALL Codex
+// traffic is covered — warmup job, chat pipeline, preflight — not just one
+// caller. Unconditional on purpose: the failing exchange only reproduces in
+// prod. Remove together with the rest of patch 0111 once tuned.
+
+function redactAuthorization(headers: Record<string, string>): Record<string, string> {
+  const redacted: Record<string, string> = {};
+  for (const [name, value] of Object.entries(headers ?? {})) {
+    redacted[name] = name.toLowerCase() === "authorization" ? "<redacted>" : value;
+  }
+  return redacted;
+}
+
+export function logCodexRawExchange(
+  logTag: string,
+  exchange: {
+    url: string;
+    headers: Record<string, string>;
+    body: unknown;
+    response: Response;
+  }
+): void {
+  try {
+    console.log(
+      `[${logTag}] raw request: ${JSON.stringify({
+        url: exchange.url,
+        headers: redactAuthorization(exchange.headers ?? {}),
+        body: exchange.body ?? null,
+      })}`
+    );
+  } catch (err) {
+    console.warn(
+      `[${logTag}] failed to serialize raw exchange:`,
+      err instanceof Error ? err.message : String(err)
+    );
+  }
+}
