+// ─── TEMP diagnostic logging (patch 0111) ───────────────────────────────────
+// Logs every Codex HTTP exchange (request body + response status/body) while
+// the "warmup request visibility" investigation runs. Lives here so ALL Codex
+// traffic is covered — warmup job, chat pipeline, preflight — not just one
+// caller. Unconditional on purpose: the failing exchange only reproduces in
+// prod. Remove together with the rest of patch 0111 once tuned.
+
+const CODEX_DIAG_BODY_CAP_BYTES = 4096;
+const CODEX_DIAG_BODY_TIMEOUT_MS = 5_000;
+
+function redactAuthorization(headers: Record<string, string>): Record<string, string> {
+  const redacted: Record<string, string> = {};
+  for (const [name, value] of Object.entries(headers ?? {})) {
+    redacted[name] = name.toLowerCase() === "authorization" ? "<redacted>" : value;
+  }
+  return redacted;
+}
+
+/**
+ * Reads at most `maxBytes` from a (possibly never-ending SSE) body, giving up
+ * after `timeoutMs`, so a diagnostic read can never wedge the caller. Always
+ * cancels the reader: the clone this runs on exists only for logging.
+ */
+async function readBodyCapped(
+  body: ReadableStream<Uint8Array> | null,
+  maxBytes: number,
+  timeoutMs: number
+): Promise<string> {
+  if (!body) return "";
+  const reader = body.getReader();
+  const chunks: Uint8Array[] = [];
+  let total = 0;
+  const deadline = Date.now() + timeoutMs;
+  try {
+    while (total < maxBytes) {
+      const remaining = deadline - Date.now();
+      if (remaining <= 0) break;
+      let timeoutId: ReturnType<typeof setTimeout> | null = null;
+      const timeout = new Promise<{ done: true; value: undefined }>((resolve) => {
+        timeoutId = setTimeout(() => resolve({ done: true, value: undefined }), remaining);
+      });
+      let next: ReadableStreamReadResult<Uint8Array>;
+      try {
+        next = await Promise.race([reader.read(), timeout]);
+      } finally {
+        if (timeoutId) clearTimeout(timeoutId);
+      }
+      if (next.done) break;
+      if (next.value) {
+        chunks.push(next.value);
+        total += next.value.byteLength;
+      }
+    }
+  } catch {
+    // best-effort diagnostic read
+  } finally {
+    try {
+      await reader.cancel();
+    } catch {
+      // already closed
+    }
+  }
+  const collected = chunks.reduce((n, c) => n + c.byteLength, 0);
+  const out = new Uint8Array(Math.min(collected, maxBytes));
+  let offset = 0;
+  for (const chunk of chunks) {
+    if (offset >= out.byteLength) break;
+    out.set(chunk.subarray(0, out.byteLength - offset), offset);
+    offset += chunk.byteLength;
+  }
+  return new TextDecoder().decode(out);
+}
+
+/**
+ * Shared raw-exchange logger (patch 0111). Logs the request side immediately
+ * and the response side via a clone with a capped read. Never throws.
+ */
+export function logCodexRawExchange(
+  logTag: string,
+  exchange: {
+    url: string;
+    headers: Record<string, string>;
+    body: unknown;
+    response: Response;
+  }
+): void {
+  try {
+    console.log(
+      `[${logTag}] raw request: ${JSON.stringify({
+        url: exchange.url,
+        headers: redactAuthorization(exchange.headers ?? {}),
+        body: exchange.body ?? null,
+      })}`
+    );
+    const responseCopy = exchange.response.clone();
+    void (async () => {
+      try {
+        const bodyText = await readBodyCapped(
+          responseCopy.body,
+          CODEX_DIAG_BODY_CAP_BYTES,
+          CODEX_DIAG_BODY_TIMEOUT_MS
+        );
+        console.log(
+          `[${logTag}] raw response: ${JSON.stringify({
+            url: exchange.url,
+            status: responseCopy.status,
+            headers: Object.fromEntries(responseCopy.headers),
+            body: bodyText,
+          })}`
+        );
+      } catch (err) {
+        console.warn(
+          `[${logTag}] failed to read raw response body:`,
+          err instanceof Error ? err.message : String(err)
+        );
+      }
+    })();
+  } catch (err) {
+    console.warn(
+      `[${logTag}] failed to serialize raw exchange:`,
+      err instanceof Error ? err.message : String(err)
+    );
+  }
+}
