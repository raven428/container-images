+// Unit tests for the TEMP Codex raw-exchange diagnostics (patch 0111).
+//
+// Exercises the REAL executor pipeline with a stubbed globalThis.fetch and
+// asserts the exact diagnostic output:
+//   - [SessionWarmup][Codex:<id>] raw request / raw response  (warmup path)
+//   - [CodexExec] raw request / raw response                   (executor hook)
+//   - [CodexUsage] raw payload / non-ok payload                (quota fetch)
+// plus Authorization redaction on every logged header set.
+//
+// These tests die together with patch 0111 — the diagnostics are temporary.
+
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const TEST_DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), "omni-warmup-logging-"));
+process.env.DATA_DIR = TEST_DATA_DIR;
+process.env.DISABLE_SQLITE_AUTO_BACKUP = "true";
+
+const originalFetch = globalThis.fetch;
+
+const logLines: string[] = [];
+const warnLines: string[] = [];
+const originalLog = console.log;
+const originalWarn = console.warn;
+const originalError = console.error;
+
+const localDb = await import("../../src/lib/localDb.ts");
+const warmup = await import("../../src/lib/sessionWarmupJob.ts");
+
+const USAGE_URL = "https://chatgpt.com/backend-api/wham/usage";
+
+const calls: { url: string; init?: RequestInit }[] = [];
+let usagePayload: () => Record<string, unknown> = () => ({});
+let usageStatus: () => number = () => 200;
+let responsesBody: string = 'data: {"type":"response.completed"}\n\ndata: [DONE]\n\n';
+
+// Install AFTER imports: proxyFetch's module side effect replaces
+// globalThis.fetch with an undici-backed patchedFetch, which would bypass
+// the stub (and hang on real network egress).
+globalThis.fetch = (async (input: RequestInfo | URL, init?: RequestInit) => {
+  const url = typeof input === "string" ? input : input.toString();
+  calls.push({ url, init });
+  if (url.includes("/backend-api/wham/usage")) {
+    return new Response(
+      usageStatus() === 200 ? JSON.stringify(usagePayload()) : "usage backend exploded",
+      {
+        status: usageStatus(),
+        headers: { "content-type": "application/json" },
+      }
+    );
+  }
+  if (url.includes("/backend-api/codex/responses")) {
+    return new Response(responsesBody, {
+      status: 200,
+      headers: { "content-type": "text/event-stream" },
+    });
+  }
+  return new Response("{}", { status: 200 });
+}) as typeof fetch;
+
+async function resetStorage() {
+  const coreDb = await import("../../src/lib/db/core.ts");
+  coreDb.resetDbInstance();
+  fs.rmSync(TEST_DATA_DIR, { recursive: true, force: true });
+  fs.mkdirSync(TEST_DATA_DIR, { recursive: true });
+}
+
+function floatingWindowPayload(): Record<string, unknown> {
+  return {
+    rate_limit: {
+      allowed: true,
+      limit_reached: false,
+      primary_window: {
+        used_percent: 0,
+        limit_window_seconds: 18000,
+        reset_after_seconds: 18000,
+        reset_at: Math.floor(Date.now() / 1000) + 18000,
+      },
+      secondary_window: {
+        used_percent: 46,
+        limit_window_seconds: 604800,
+        reset_after_seconds: 311156,
+        reset_at: Math.floor(Date.now() / 1000) + 311156,
+      },
+    },
+  };
+}
+
+function activeSessionPayload(): Record<string, unknown> {
+  return {
+    rate_limit: {
+      allowed: true,
+      limit_reached: false,
+      primary_window: {
+        used_percent: 3,
+        limit_window_seconds: 18000,
+        reset_after_seconds: 1234,
+        reset_at: Math.floor(Date.now() / 1000) + 1234,
+      },
+      secondary_window: {
+        used_percent: 46,
+        limit_window_seconds: 604800,
+        reset_after_seconds: 311156,
+        reset_at: Math.floor(Date.now() / 1000) + 311156,
+      },
+    },
+  };
+}
+
+async function createWarmupConnection(): Promise<string> {
+  const created = await localDb.createProviderConnection({
+    provider: "codex",
+    name: "codex-logging-test",
+    authType: "oauth",
+    email: "logging@example.com",
+    accessToken: "super-secret-access-token",
+    refreshToken: "super-secret-refresh-token",
+    tokenExpiresAt: new Date(Date.now() + 3600_000).toISOString(),
+    isActive: true,
+    providerSpecificData: {
+      workspaceId: "ws-logging",
+      sessionWarmupEnabled: true,
+    },
+  });
+  assert.ok(created?.id, "connection must be created");
+  return created.id as string;
+}
+
+async function runWarmupSweep(connectionId: string): Promise<void> {
+  const conn = (await localDb.getProviderConnectionById(connectionId)) as unknown as Record<
+    string,
+    unknown
+  >;
+  await warmup.processConnection(conn);
+}
+
+async function waitFor(predicate: () => boolean, timeoutMs = 5_000): Promise<boolean> {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    if (predicate()) return true;
+    await new Promise((resolve) => setTimeout(resolve, 25));
+  }
+  return predicate();
+}
+
+test.beforeEach(async () => {
+  await resetStorage();
+  warmup._resetSessionWarmupState();
+  calls.length = 0;
+  logLines.length = 0;
+  warnLines.length = 0;
+  usagePayload = () => floatingWindowPayload();
+  usageStatus = () => 200;
+  responsesBody = 'data: {"type":"response.completed"}\n\ndata: [DONE]\n\n';
+  console.log = (...args: unknown[]) => {
+    logLines.push(args.map(String).join(" "));
+  };
+  console.warn = (...args: unknown[]) => {
+    warnLines.push(args.map(String).join(" "));
+  };
+  console.error = () => {};
+});
+
+test.afterEach(() => {
+  console.log = originalLog;
+  console.warn = originalWarn;
+  console.error = originalError;
+});
+
+test.after(() => {
+  globalThis.fetch = originalFetch;
+});
+
+test("warmup exchange is fully logged: url, redacted headers, body, response", async () => {
+  const id = await createWarmupConnection();
+  await runWarmupSweep(id);
+
+  const requestLine = logLines.find((line) =>
+    line.includes(`[SessionWarmup][Codex:${id}] raw request:`)
+  );
+  assert.ok(requestLine, "raw request line must be logged");
+  const request = JSON.parse(requestLine.split(" raw request: ")[1]) as {
+    url: string;
+    headers: Record<string, string>;
+    body: Record<string, unknown>;
+  };
+  assert.equal(request.url, "https://chatgpt.com/backend-api/codex/responses");
+  assert.equal(request.headers.Authorization, "<redacted>");
+  assert.ok(!JSON.stringify(request).includes("super-secret-access-token"));
+  assert.equal(request.body.model, "gpt-5.6-luna");
+
+  const responseSeen = await waitFor(() =>
+    logLines.some((line) => line.includes(`[SessionWarmup][Codex:${id}] raw response:`))
+  );
+  assert.ok(responseSeen, "raw response line must be logged");
+  const responseLine = logLines.find((line) =>
+    line.includes(`[SessionWarmup][Codex:${id}] raw response:`)
+  )!;
+  const response = JSON.parse(responseLine.split(" raw response: ")[1]) as {
+    status: number;
+    body: string;
+  };
+  assert.equal(response.status, 200);
+  assert.ok(response.body.includes("response.completed"));
+});
+
+test("executor-level [CodexExec] logging covers the same exchange", async () => {
+  const id = await createWarmupConnection();
+  await runWarmupSweep(id);
+
+  const execRequest = logLines.find((line) => line.startsWith("[CodexExec] raw request:"));
+  assert.ok(execRequest, "executor request line must be logged");
+  const request = JSON.parse(execRequest.split(" raw request: ")[1]) as {
+    url: string;
+    headers: Record<string, string>;
+  };
+  assert.equal(request.url, "https://chatgpt.com/backend-api/codex/responses");
+  assert.equal(request.headers.Authorization, "<redacted>");
+
+  const responseSeen = await waitFor(() =>
+    logLines.some((line) => line.startsWith("[CodexExec] raw response:"))
+  );
+  assert.ok(responseSeen, "executor response line must be logged");
+  assert.ok(
+    logLines.some(
+      (line) =>
+        line.startsWith("[CodexExec] raw response:") && line.includes("response.completed")
+    ),
+    "executor response line must carry the body"
+  );
+
+  // The quota fetch must NOT go through the executor hook.
+  assert.equal(
+    logLines.filter((line) => line.startsWith("[CodexExec] raw request:")).length,
+    calls.filter((c) => c.url.includes("/codex/responses")).length,
+    "one executor log per /codex/responses call, none for the usage fetch"
+  );
+});
+
+test("quota fetch logs the raw payload on ok and a warning on non-ok", async () => {
+  const id = await createWarmupConnection();
+
+  usageStatus = () => 503;
+  await runWarmupSweep(id);
+  assert.ok(
+    warnLines.some((line) => line.includes("[CodexUsage] non-ok payload") && line.includes("503")),
+    "non-ok usage response must be logged"
+  );
+  assert.ok(
+    logLines.some((line) => line.includes("Sending warmup to codex/")),
+    "a failing quota endpoint must still let the warmup fire (cold cache => null session)"
+  );
+
+  // Post-warmup: flip the quota endpoint back to a healthy payload and rewind
+  // the warmup TTL so the next sweep actually refreshes quotas again (a fresh
+  // warmup would TTL-skip before ever touching the usage endpoint).
+  usageStatus = () => 200;
+  usagePayload = () => activeSessionPayload();
+  await localDb.updateProviderConnection(id, {
+    providerSpecificData: {
+      workspaceId: "ws-logging",
+      sessionWarmupEnabled: true,
+      lastSessionWarmupAt: new Date(Date.now() - 61 * 60_000).toISOString(),
+    },
+  });
+  await runWarmupSweep(id);
+  assert.ok(
+    logLines.some((line) => line.includes("[CodexUsage] raw payload for ws-logging")),
+    "healthy usage responses must dump the raw payload"
+  );
+  const rawLine = logLines.find((line) => line.includes("[CodexUsage] raw payload"))!;
+  assert.ok(rawLine.includes('"primary_window"'));
+  assert.ok(rawLine.includes('"reset_after_seconds":1234'));
+});
