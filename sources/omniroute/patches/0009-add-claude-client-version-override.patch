+  DEFAULT_CLAUDE_CODE_VERSION,
+  getDefaultClaudeCodeVersion,
+  buildBillingHeaderValue,
+  computeDaystampVersionSuffix,
+} from '../../open-sse/services/ccBridgeTransforms.ts';
+// Adapted from upstream tests/unit/cli-client-version-env-12417.test.ts.
+async function withEnv<T>(
+  entries: Record<string, string | undefined>,
+  fn: () => T | Promise<T>
+): Promise<T> {
+  const previous = new Map<string, string | undefined>();
+  for (const [key, value] of Object.entries(entries)) {
+    previous.set(key, process.env[key]);
+    if (value === undefined) delete process.env[key];
+    else process.env[key] = value;
+  }
+  try {
+    return await fn();
+  } finally {
+    for (const [key, value] of previous.entries()) {
+      if (value === undefined) delete process.env[key];
+      else process.env[key] = value;
+    }
+  }
+}
+const billingOptions = {
+  entrypoint: 'sdk-cli',
+  versionFormat: 'omniroute-daystamp' as const,
+  cchAlgo: 'xxhash64-body' as const,
+  now: new Date('2026-01-02T12:00:00Z'),
+};
+const messages = [{ role: 'user', content: 'hello' }];
+test('native and bridge pins default to 2.1.181', async () => {
+  assert.equal(CLAUDE_CODE_CLIENT_VERSION, '2.1.181');
+  assert.equal(CLAUDE_CODE_VERSION, CLAUDE_CODE_CLIENT_VERSION);
+  assert.equal(CLAUDE_CODE_COMPATIBLE_VERSION, CLAUDE_CODE_CLIENT_VERSION);
+  assert.equal(DEFAULT_CLAUDE_CODE_VERSION, CLAUDE_CODE_CLIENT_VERSION);
+  assert.equal(
+    CLAUDE_CODE_COMPATIBLE_USER_AGENT,
+    'claude-cli/2.1.181 (external, sdk-cli)'
+  );
+  await withEnv({ CLAUDE_CODE_CLIENT_VERSION: undefined }, () => {
+    assert.equal(getClaudeCodeClientVersion(), '2.1.181');
+    assert.equal(getClaudeCodeVersion(), '2.1.181');
+    assert.equal(getDefaultClaudeCodeVersion(), '2.1.181');
+    assert.equal(getClaudeCodeUserAgent('cli'), 'claude-cli/2.1.181 (external, cli)');
+    const suffix = computeDaystampVersionSuffix('2.1.181', billingOptions.now);
+    assert.ok(
+      buildBillingHeaderValue(messages, billingOptions).includes(`2.1.181.${suffix}`)
+    );
+  });
+});
+test('safe overrides are trimmed and read at call time, while pins stay fixed', async () => {
+  for (const version of ['2.1.182', '2.1.183']) {
+    await withEnv({ CLAUDE_CODE_CLIENT_VERSION: ` ${version} ` }, () => {
+      assert.equal(getClaudeCodeClientVersion(), version);
+      assert.equal(getClaudeCodeVersion(), version);
+      assert.equal(getDefaultClaudeCodeVersion(), version);
+      assert.equal(
+        getClaudeCodeUserAgent('cli'),
+        `claude-cli/${version} (external, cli)`
+      );
+      assert.equal(
+        buildClaudeCodeCompatibleHeaders('test-token')['User-Agent'],
+        `claude-cli/${version} (external, sdk-cli)`
+      );
+      const suffix = computeDaystampVersionSuffix(version, billingOptions.now);
+      assert.ok(
+        buildBillingHeaderValue(messages, billingOptions).includes(`${version}.${suffix}`)
+      );
+      assert.equal(CLAUDE_CODE_VERSION, '2.1.181');
+    });
+  }
+});
+test('empty, unsafe and oversized env overrides fall back to the pin', async () => {
+  for (const value of [
+    '',
+    ' ',
+    'bad version',
+    '2.1.182\r\nx-header: bad',
+    'a'.repeat(33),
+  ]) {
+    await withEnv({ CLAUDE_CODE_CLIENT_VERSION: value }, () => {
+      assert.equal(getClaudeCodeClientVersion(), '2.1.181');
+    });
+  }
+});
+test('the old CLAUDE_CODE_VERSION env name is not used', async () => {
+  await withEnv(
+    { CLAUDE_CODE_CLIENT_VERSION: undefined, CLAUDE_CODE_VERSION: '9.9.9' },
+    () => {
+      assert.equal(getClaudeCodeClientVersion(), '2.1.181');
+    }
