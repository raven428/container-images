+import React, { memo, useMemo } from 'react';
+import type { TMessage } from 'librechat-data-provider';
+import { useOptionalMessagesOperations } from '~/Providers/MessagesViewContext';
+import { cn } from '~/utils';
+import {
+  computeResponseDurationMs,
+  formatDuration,
+  formatMessageTime,
+} from '~/utils/messageTime';
+
+type MessageTimeInfoProps = {
+  message: TMessage;
+  /**
+   * When true the info is visible at all times; otherwise it only appears
+   * while the surrounding `.group` is hovered/focused — mirroring the
+   * behaviour of HoverButtons.
+   */
+  isLast?: boolean;
+};
+
+/**
+ * Renders the message creation time (ISO without seconds) and, for assistant
+ * messages, the duration between the parent user message and this assistant
+ * reply. Styled to sit alongside HoverButtons in the message SubRow.
+ *
+ * For assistant messages the duration is rendered first, then the timestamp,
+ * separated by a middle dot — e.g. `12.3s · 2026-05-27 14:33`.
+ */
+function MessageTimeInfo({ message, isLast = false }: MessageTimeInfoProps) {
+  const { getMessages } = useOptionalMessagesOperations();
+
+  const createdAt = message.createdAt;
+  const parentId = message.parentMessageId;
+  const isAssistant = message.isCreatedByUser !== true;
+
+  const parentCreatedAt = useMemo(() => {
+    if (!isAssistant || !parentId) {
+      return null;
+    }
+    const messages = getMessages();
+    if (!messages) {
+      return null;
+    }
+    const parent = messages.find((m) => m.messageId === parentId);
+    return parent?.createdAt ?? null;
+  }, [getMessages, isAssistant, parentId]);
+
+  const durationMs = useMemo(
+    () => (isAssistant ? computeResponseDurationMs(parentCreatedAt, createdAt) : null),
+    [isAssistant, parentCreatedAt, createdAt],
+  );
+
+  if (!createdAt) {
+    return null;
+  }
+
+  const timestamp = formatMessageTime(createdAt);
+  if (!timestamp) {
+    return null;
+  }
+  const duration = durationMs != null ? formatDuration(durationMs) : '';
+  const isoAttr = typeof createdAt === 'string' ? createdAt : undefined;
+
+  return (
+    <span
+      className={cn(
+        'flex select-none items-center gap-1 self-end text-text-secondary',
+        !isLast &&
+          'md:opacity-0 md:group-hover:opacity-100 md:group-focus-within:opacity-100',
+      )}
+      data-testid="message-time-info"
+    >
+      {duration ? (
+        <>
+          <span aria-label={`response duration ${duration}`}>{duration}</span>
+          <span aria-hidden="true">·</span>
+        </>
+      ) : null}
+      <time dateTime={isoAttr}>{timestamp}</time>
+    </span>
+  );
+}
+
+export default memo(MessageTimeInfo);
