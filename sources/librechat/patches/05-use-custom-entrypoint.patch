--- a/Dockerfile
+++ b/Dockerfile
@@ -1,19 +1,25 @@
 # v0.8.5
 
 # Base node image
-FROM node:20-alpine AS node
+FROM node:24-trixie-slim AS node
 
-RUN apk upgrade --no-cache
-RUN apk add --no-cache jemalloc
-RUN apk add --no-cache python3 py3-pip uv
+RUN apt-get update && apt-get install -y --no-install-recommends \
+    libjemalloc2 python3 python3-pip ca-certificates curl xz-utils && \
+    rm -rf /var/lib/apt/lists/*
 
 # Set environment variable to use jemalloc
-ENV LD_PRELOAD=/usr/lib/libjemalloc.so.2
+ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2
 
 # Add `uv` for extended MCP support
-COPY --from=ghcr.io/astral-sh/uv:0.9.5-python3.12-alpine /usr/local/bin/uv /usr/local/bin/uvx /bin/
+COPY --from=ghcr.io/astral-sh/uv:0.9.5-python3.12-trixie-slim /usr/local/bin/uv /usr/local/bin/uvx /bin/
 RUN uv --version
 
+# Install rootless podman for nested MCP servers (e.g. ozon-mcp-server).
+# setup-podman.sh wires subuid/subgid, containers.conf and storage.conf for
+# the node user; mirrors sources/vibeco-ubuntu-24_04.
+COPY podman.sh setup-podman.sh /tmp/
+RUN bash /tmp/setup-podman.sh && rm -f /tmp/podman.sh /tmp/setup-podman.sh
+
 # Set configurable max-old-space-size with default
 ARG NODE_MAX_OLD_SPACE_SIZE=6144
 
@@ -50,7 +56,8 @@
 # Node API setup
 EXPOSE 3080
 ENV HOST=0.0.0.0
-CMD ["npm", "run", "backend"]
+COPY files/ /app/
+CMD ["node", "/app/entrypoint.js"]
 
 # Optional: for client with nginx routing
 # FROM nginx:stable-alpine AS nginx-client
