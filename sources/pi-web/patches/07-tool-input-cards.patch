+import { css as cssLang } from "@codemirror/lang-css";
+import { go } from "@codemirror/lang-go";
+import { html as htmlLang } from "@codemirror/lang-html";
+import { javascript } from "@codemirror/lang-javascript";
+import { json } from "@codemirror/lang-json";
+import { markdown } from "@codemirror/lang-markdown";
+import { python } from "@codemirror/lang-python";
+import { rust } from "@codemirror/lang-rust";
+import { defaultHighlightStyle } from "@codemirror/language";
+import { highlightTree } from "@lezer/highlight";
+import type { CodeLanguage } from "./codeLanguage";
+
+export interface CodeHighlightSegment {
+  text: string;
+  className?: string;
+}
+
+export type CodeHighlightLine = CodeHighlightSegment[];
+
+const MAX_HIGHLIGHT_CACHE_ENTRIES = 100;
+const MAX_HIGHLIGHT_TEXT_LENGTH = 500_000;
+const highlightCache = new Map<string, CodeHighlightLine[]>();
+const parsers = {
+  typescript: javascript({ typescript: true }).language.parser,
+  javascript: javascript().language.parser,
+  json: json().language.parser,
+  markdown: markdown().language.parser,
+  css: cssLang().language.parser,
+  html: htmlLang().language.parser,
+  python: python().language.parser,
+  rust: rust().language.parser,
+  go: go().language.parser,
+};
+let sharedStyleSheet: CSSStyleSheet | undefined;
+
+export function highlightCode(text: string, language: CodeLanguage): CodeHighlightLine[] {
+  if (text.length > MAX_HIGHLIGHT_TEXT_LENGTH) return plainCodeLines(text);
+  const key = `${language}\u0000${text}`;
+  const cached = highlightCache.get(key);
+  if (cached !== undefined) return cached;
+  const runs: { from: number; to: number; className: string }[] = [];
+  highlightTree(parsers[language].parse(text), defaultHighlightStyle, (from, to, className) => {
+    runs.push({ from, to, className });
+  });
+  const lines = splitHighlightedLines(text, runs);
+  highlightCache.set(key, lines);
+  if (highlightCache.size > MAX_HIGHLIGHT_CACHE_ENTRIES) {
+    const oldest = highlightCache.keys().next().value;
+    if (oldest !== undefined) highlightCache.delete(oldest);
+  }
+  return lines;
+}
+
+export function installCodeHighlightStyles(root: ShadowRoot): void {
+  if (!("adoptedStyleSheets" in root) || typeof CSSStyleSheet === "undefined") return;
+  try {
+    sharedStyleSheet ??= createHighlightStyleSheet();
+    if (!root.adoptedStyleSheets.includes(sharedStyleSheet)) {
+      root.adoptedStyleSheets = [...root.adoptedStyleSheets, sharedStyleSheet];
+    }
+  } catch {
+    return;
+  }
+}
+
+function createHighlightStyleSheet(): CSSStyleSheet {
+  const sheet = new CSSStyleSheet();
+  sheet.replaceSync(defaultHighlightStyle.module?.getRules() ?? "");
+  return sheet;
+}
+
+function splitHighlightedLines(
+  text: string,
+  runs: readonly { from: number; to: number; className: string }[],
+): CodeHighlightLine[] {
+  const lines: CodeHighlightLine[] = [];
+  let lineStart = 0;
+  let runIndex = 0;
+  while (lineStart <= text.length) {
+    const newline = text.indexOf("\n", lineStart);
+    const lineEnd = newline < 0 ? text.length : newline;
+    const line: CodeHighlightLine = [];
+    let cursor = lineStart;
+    while (runIndex < runs.length && (runs[runIndex]?.to ?? 0) <= lineStart) runIndex++;
+    let currentRun = runIndex;
+    while (currentRun < runs.length) {
+      const run = runs[currentRun];
+      if (run === undefined || run.from >= lineEnd) break;
+      const from = Math.max(cursor, lineStart, run.from);
+      const to = Math.min(lineEnd, run.to);
+      if (from > cursor) appendSegment(line, text.slice(cursor, from));
+      if (to > from) appendSegment(line, text.slice(from, to), run.className);
+      cursor = Math.max(cursor, to);
+      currentRun++;
+    }
+    if (cursor < lineEnd) appendSegment(line, text.slice(cursor, lineEnd));
+    lines.push(line);
+    if (newline < 0) break;
+    lineStart = newline + 1;
+  }
+  return lines;
+}
+
+function appendSegment(line: CodeHighlightLine, text: string, className?: string): void {
+  if (text === "") return;
+  const previous = line[line.length - 1];
+  if (previous !== undefined && previous.className === className) {
+    previous.text += text;
+    return;
+  }
+  line.push(className === undefined ? { text } : { text, className });
+}
+
+function plainCodeLines(text: string): CodeHighlightLine[] {
+  return text.split("\n").map((line) => line === "" ? [] : [{ text: line }]);
+}
