+import json
+from collections.abc import AsyncIterator
+
+from pydantic import BaseModel
+
+
+class TokenUsageSchema(BaseModel):
+    prompt_tokens: int | None = None
+    completion_tokens: int | None = None
+    total_tokens: int | None = None
+
+
+class ChatChunkSchema(BaseModel):
+    delta: str = ""
+    # Some providers (GLM/Zhipu, DeepSeek-R1 style) stream chain-of-thought
+    # separately from the answer content, in a dedicated `reasoning_content`
+    # field on OpenAI-compatible chat completion chunks. We surface it as its
+    # own attribute so the gateway can route it to the thinking log channel
+    # without having to guess based on <think> tags.
+    reasoning: str = ""
+    usage: TokenUsageSchema | None = None
+
+
+def _safe_usage(obj: dict) -> TokenUsageSchema | None:
+    if not obj:
+        return None
+    return TokenUsageSchema(
+        prompt_tokens=obj.get("prompt_tokens") or obj.get("input_tokens"),
+        completion_tokens=obj.get("completion_tokens") or obj.get("output_tokens"),
+        total_tokens=obj.get("total_tokens"),
+    )
+
+
+async def parse_openai_sse(lines: AsyncIterator[str]) -> AsyncIterator[ChatChunkSchema]:
+    """OpenAI v1 / OpenRouter / Azure OpenAI chat-completion streaming."""
+    async for line in lines:
+        line = line.strip()
+        if not line or not line.startswith("data:"):
+            continue
+        data = line[len("data:"):].strip()
+        if data == "[DONE]" or not data:
+            continue
+        try:
+            payload = json.loads(data)
+        except json.JSONDecodeError:
+            continue
+
+        usage = _safe_usage(payload.get("usage"))
+
+        delta = ""
+        reasoning = ""
+        choices = payload.get("choices") or []
+        if choices:
+            delta_obj = choices[0].get("delta") or {}
+            delta = delta_obj.get("content") or ""
+            # GLM / DeepSeek-R1 / Zhipu-style extended thinking: reasoning is
+            # streamed in a sibling field before the answer starts. Without
+            # picking it up the gateway sees only empty deltas during the
+            # (often long) thinking phase and stays silent.
+            reasoning = (
+                delta_obj.get("reasoning_content")
+                or delta_obj.get("reasoning")
+                or ""
+            )
+
+        if not delta and not reasoning and usage is None:
+            continue
+        yield ChatChunkSchema(delta=delta, reasoning=reasoning, usage=usage)
+
+
+async def parse_openai_v2_sse(lines: AsyncIterator[str]) -> AsyncIterator[ChatChunkSchema]:
+    """OpenAI v2 Responses API streaming (response.output_text.delta events)."""
+    async for line in lines:
+        line = line.strip()
+        if not line or not line.startswith("data:"):
+            continue
+        data = line[len("data:"):].strip()
+        if data == "[DONE]" or not data:
+            continue
+        try:
+            payload = json.loads(data)
+        except json.JSONDecodeError:
+            continue
+
+        event_type = payload.get("type")
+
+        if event_type == "response.output_text.delta":
+            delta = payload.get("delta") or ""
+            if delta:
+                yield ChatChunkSchema(delta=delta)
+            continue
+
+        if event_type in ("response.completed", "response.done"):
+            response = payload.get("response") or {}
+            usage = _safe_usage(response.get("usage"))
+            if usage is not None:
+                yield ChatChunkSchema(delta="", usage=usage)
+
+
+async def parse_claude_sse(lines: AsyncIterator[str]) -> AsyncIterator[ChatChunkSchema]:
+    """Anthropic Messages streaming (content_block_delta / message_delta)."""
+    input_tokens = None
+    output_tokens = None
+    async for line in lines:
+        line = line.strip()
+        if not line or not line.startswith("data:"):
+            continue
+        data = line[len("data:"):].strip()
+        if not data:
+            continue
+        try:
+            payload = json.loads(data)
+        except json.JSONDecodeError:
+            continue
+
+        event_type = payload.get("type")
+
+        if event_type == "message_start":
+            message = payload.get("message") or {}
+            usage = message.get("usage") or {}
+            input_tokens = usage.get("input_tokens")
+            output_tokens = usage.get("output_tokens")
+            continue
+
+        if event_type == "content_block_delta":
+            delta_obj = payload.get("delta") or {}
+            if delta_obj.get("type") in ("text_delta", "text"):
+                text = delta_obj.get("text") or ""
+                if text:
+                    yield ChatChunkSchema(delta=text)
+            continue
+
+        if event_type == "message_delta":
+            usage = payload.get("usage") or {}
+            if usage.get("output_tokens") is not None:
+                output_tokens = usage["output_tokens"]
+            total = (input_tokens or 0) + (output_tokens or 0) if input_tokens or output_tokens else None
+            yield ChatChunkSchema(
+                delta="",
+                usage=TokenUsageSchema(
+                    prompt_tokens=input_tokens,
+                    completion_tokens=output_tokens,
+                    total_tokens=total,
+                ),
+            )
+            continue
+
+
+async def parse_gemini_sse(lines: AsyncIterator[str]) -> AsyncIterator[ChatChunkSchema]:
+    """Gemini streamGenerateContent streaming (SSE or raw NDJSON)."""
+    async for line in lines:
+        line = line.strip()
+        if not line:
+            continue
+        if line.startswith("data:"):
+            data = line[len("data:"):].strip()
+        else:
+            data = line
+        if not data:
+            continue
+        try:
+            payload = json.loads(data)
+        except json.JSONDecodeError:
+            continue
+
+        delta = ""
+        candidates = payload.get("candidates") or []
+        if candidates:
+            content = candidates[0].get("content") or {}
+            parts = content.get("parts") or []
+            for part in parts:
+                if part.get("thought"):
+                    continue
+                text = part.get("text")
+                if text:
+                    delta += text
+
+        usage = None
+        meta = payload.get("usageMetadata")
+        if meta:
+            usage = TokenUsageSchema(
+                prompt_tokens=meta.get("promptTokenCount"),
+                completion_tokens=meta.get("candidatesTokenCount") or meta.get("outputThoughtsTokenCount"),
+                total_tokens=meta.get("totalTokenCount"),
+            )
+
+        if not delta and usage is None:
+            continue
+        yield ChatChunkSchema(delta=delta, usage=usage)
+
+
+async def parse_ollama_ndjson(lines: AsyncIterator[str]) -> AsyncIterator[ChatChunkSchema]:
+    """Ollama /api/chat NDJSON streaming."""
+    async for line in lines:
+        line = line.strip()
+        if not line:
+            continue
+        try:
+            payload = json.loads(line)
+        except json.JSONDecodeError:
+            continue
+
+        message = payload.get("message") or {}
+        delta = message.get("content") or ""
+
+        if payload.get("done"):
