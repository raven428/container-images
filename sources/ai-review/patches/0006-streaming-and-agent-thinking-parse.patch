+@pytest.mark.asyncio
+async def test_ask_stream_routes_thinking_blocks_to_separate_log_channel(
+        capsys: pytest.CaptureFixture,
+        monkeypatch: pytest.MonkeyPatch,
+        review_direct_llm_gateway: ReviewDirectLLMGateway,
+        fake_llm_client: FakeLLMClient,
+):
+    """<think>...</think> content must show up as a separate log line."""
+    monkeypatch.setattr("ai_review.config.settings.llm.meta.stream_log_progress", True)
+    monkeypatch.setattr("ai_review.config.settings.llm.meta.stream_log_chunk_chars", 5)
+
+    # Simulate a reasoning model that streams its thinking before the answer,
+    # with tag boundaries split across chunk boundaries (realistic case).
+    fake_llm_client.responses["chat_stream"] = [
+        ChatChunkSchema(delta="hello <thi"),
+        ChatChunkSchema(delta="nk>step one, step two"),
+        ChatChunkSchema(delta=", conclusion</think>"),
+        ChatChunkSchema(delta=" world"),
+        ChatChunkSchema(
+            delta="",
+            usage=TokenUsageSchema(prompt_tokens=1, completion_tokens=1, total_tokens=2),
+        ),
+    ]
+
+    collected: list[str] = []
+    async for delta in review_direct_llm_gateway.ask_stream("P", "S"):
+        collected.append(delta)
+
+    # The stream downstream is unchanged — the parser upstream will strip
+    # <think> via strip_thinking(); we only split channels for logging.
+    assert "".join(collected) == "hello <think>step one, step two, conclusion</think> world"
+
+    output = capsys.readouterr().out
+    assert "Streaming thinking" in output
+    assert "Streaming progress" in output
+
+    progress_lines = [line for line in output.splitlines() if "Streaming progress" in line]
+    thinking_lines = [line for line in output.splitlines() if "Streaming thinking" in line]
+
+    # Answer channel must not contain either the tag or the reasoning text.
+    for line in progress_lines:
+        assert "<think" not in line
+        assert "</think" not in line
+        assert "step one" not in line
+        assert "conclusion" not in line
+
+    # Thinking channel must contain the reasoning content.
+    thinking_dump = "\n".join(thinking_lines)
+    assert "step one" in thinking_dump
+    assert "conclusion" in thinking_dump
