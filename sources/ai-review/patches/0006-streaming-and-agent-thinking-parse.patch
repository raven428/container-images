--- a/ai_review/libs/llm/stream_logger.py
+++ b/ai_review/libs/llm/stream_logger.py
@@ -0,0 +1,181 @@
+import re
+from typing import Callable
+
+# We split the incoming stream into two logical channels:
+#   * regular answer text — goes to the "progress" log stream
+#   * chain-of-thought inside <think>...</think> / <thinking>...</thinking>
+#     — goes to the "thinking" log stream
+#
+# Some reasoning models (DeepSeek-R1, QwQ, Anthropic extended-thinking style)
+# emit huge multi-KB thinking blocks before producing the final answer. Without
+# separating them the operator sees a long silence after "Status 200" and has
+# no idea whether the model is stuck or just thinking hard.
+
+_OPEN_TAG_RE = re.compile(r"<think(?:ing)?>", re.IGNORECASE)
+_CLOSE_TAG_RE = re.compile(r"</think(?:ing)?>", re.IGNORECASE)
+
+# Longest possible tag literal is "</thinking>" = 11 chars. We hold back this
+# many chars from the tail of the "pending" buffer so a tag split across
+# two chunks (e.g. "<thi" | "nk>") is not misclassified.
+_MAX_TAG_LEN = len("</thinking>")
+
+
+class StreamSegmentLogger:
+    """Split streamed text into `answer` and `thinking` channels on the fly.
+
+    The caller feeds chunks via :meth:`feed`, then calls :meth:`flush` at the
+    end of the stream to release any remaining buffered content. Each channel
+    is flushed independently once the buffered length reaches
+    ``chunk_chars_threshold`` characters; a callback receives the full piece,
+    its size and the running total of characters emitted on that channel.
+    """
+
+    def __init__(
+            self,
+            chunk_chars_threshold: int,
+            on_answer: Callable[[str, int, int], None],
+            on_thinking: Callable[[str, int, int], None],
+    ) -> None:
+        self._threshold = chunk_chars_threshold
+        self._on_answer = on_answer
+        self._on_thinking = on_thinking
+
+        self._in_thinking = False
+        # Buffer that has not been dispatched to a channel yet. May contain
+        # partial tag prefix at the tail (kept until we can decide whether
+        # it is a real tag or plain text).
+        self._pending = ""
+
+        # Per-channel accumulators (flushed once threshold is exceeded).
+        self._answer_buf = ""
+        self._thinking_buf = ""
+        self._answer_total = 0
+        self._thinking_total = 0
+
+    # --------------- public API ---------------
+
+    def feed(self, delta: str) -> None:
+        if not delta:
+            return
+        self._pending += delta
+        self._drain(final=False)
+
+    def feed_thinking(self, text: str) -> None:
+        """Send text straight to the thinking channel, bypassing tag parsing.
+
+        Used when the provider streams reasoning in a dedicated field (e.g.
+        GLM's ``reasoning_content``) — there's no tag to detect and the text
+        would never appear in the answer anyway.
+        """
+        if not text:
+            return
+        self._push_thinking(text)
+
+    def flush(self) -> None:
+        # Force-drain: at end of stream any tag-lookahead reserve must go out.
+        self._drain(final=True)
+        if self._answer_buf:
+            self._emit_answer()
+        if self._thinking_buf:
+            self._emit_thinking()
+
+    # ---- observability helpers for heartbeat ----
+
+    @property
+    def answer_total(self) -> int:
+        return self._answer_total
+
+    @property
+    def thinking_total(self) -> int:
+        return self._thinking_total
+
+    @property
+    def pending_answer_chars(self) -> int:
+        return len(self._answer_buf)
+
+    @property
+    def pending_thinking_chars(self) -> int:
+        return len(self._thinking_buf)
+
+    # --------------- internals ---------------
+
+    def _drain(self, final: bool) -> None:
+        while self._pending:
+            if self._in_thinking:
+                match = _CLOSE_TAG_RE.search(self._pending)
+                if match:
+                    # Everything before the closing tag is thinking content;
+                    # then we exit the thinking mode and keep parsing the tail
+                    # for possible further tags / answer content.
+                    self._push_thinking(self._pending[:match.start()])
+                    self._pending = self._pending[match.end():]
+                    self._in_thinking = False
+                    continue
+                # No closing tag yet. Emit everything except a tail that could
+                # still be the start of one.
+                if final:
+                    self._push_thinking(self._pending)
+                    self._pending = ""
+                else:
+                    safe_len = self._safe_prefix_len()
+                    if safe_len:
+                        self._push_thinking(self._pending[:safe_len])
+                        self._pending = self._pending[safe_len:]
+                    return
+            else:
+                match = _OPEN_TAG_RE.search(self._pending)
+                if match:
+                    self._push_answer(self._pending[:match.start()])
+                    self._pending = self._pending[match.end():]
+                    self._in_thinking = True
+                    continue
+                if final:
+                    self._push_answer(self._pending)
+                    self._pending = ""
+                else:
+                    safe_len = self._safe_prefix_len()
+                    if safe_len:
+                        self._push_answer(self._pending[:safe_len])
+                        self._pending = self._pending[safe_len:]
+                    return
+
+    def _safe_prefix_len(self) -> int:
+        # We only need to hold back a tail if it could contain the beginning
+        # of a tag. Tags always start with '<'. If there's no '<' at all we
+        # can flush the whole pending buffer immediately; otherwise we keep
+        # everything from the last '<' to the end of the buffer, but at most
+        # ``_MAX_TAG_LEN - 1`` characters (a fully-formed tag was already
+        # matched by the regex above, so anything longer cannot be a prefix).
+        last_lt = self._pending.rfind("<")
+        if last_lt < 0:
+            return len(self._pending)
+        reserve = min(len(self._pending) - last_lt, _MAX_TAG_LEN - 1)
+        return len(self._pending) - reserve
+
+    def _push_answer(self, text: str) -> None:
+        if not text:
+            return
+        self._answer_buf += text
+        if len(self._answer_buf) >= self._threshold:
+            self._emit_answer()
+
+    def _push_thinking(self, text: str) -> None:
+        if not text:
+            return
+        self._thinking_buf += text
+        if len(self._thinking_buf) >= self._threshold:
+            self._emit_thinking()
+
+    def _emit_answer(self) -> None:
+        piece = self._answer_buf
+        size = len(piece)
+        self._answer_total += size
+        self._answer_buf = ""
+        self._on_answer(piece, size, self._answer_total)
+
+    def _emit_thinking(self) -> None:
+        piece = self._thinking_buf
+        size = len(piece)
+        self._thinking_total += size
+        self._thinking_buf = ""
+        self._on_thinking(piece, size, self._thinking_total)
