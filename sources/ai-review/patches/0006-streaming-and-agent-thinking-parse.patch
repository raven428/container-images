+        await asyncio.sleep(0.18)
+        yield ChatChunkSchema(delta="hello")
+        yield ChatChunkSchema(
+            delta="",
+            usage=TokenUsageSchema(prompt_tokens=1, completion_tokens=1, total_tokens=2),
+        )
