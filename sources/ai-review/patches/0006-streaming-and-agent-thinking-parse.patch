@@ -0,0 +1,23 @@
+from ai_review.config import settings
+from ai_review.services.review.gateway.types import ReviewLLMGatewayProtocol
+
+
+async def collect_prompt_result(
+        gateway: ReviewLLMGatewayProtocol,
+        prompt: str,
+        prompt_system: str,
+) -> str:
+    """Resolve the model's full response for a runner.
+
+    When streaming is enabled in ``settings.llm.meta.stream`` the response is
+    assembled from the deltas produced by ``gateway.ask_stream``; otherwise the
+    regular non-streaming ``gateway.ask`` is used. Parsing happens afterwards
+    on the fully assembled text, so parser interfaces are unchanged.
+    """
+    if settings.llm.meta.stream:
+        chunks: list[str] = []
+        async for delta in gateway.ask_stream(prompt, prompt_system):
+            chunks.append(delta)
+        return "".join(chunks)
+
+    return await gateway.ask(prompt, prompt_system)
