+++ b/ai_review/tests/suites/libs/http/test_client.py
@@ -0,0 +1,62 @@
+import pytest
+from httpx import AsyncClient, AsyncBaseTransport, Request, Response
+
+from ai_review.libs.http.client import HTTPClient
+
+
+class _CaptureTransport(AsyncBaseTransport):
+    """Records the outgoing request and returns a canned streaming response."""
+
+    def __init__(self, body: bytes = b'data: {"choices":[]}\n\n') -> None:
+        self.captured_request: Request | None = None
+        self.body = body
+
+    async def handle_async_request(self, request: Request) -> Response:
+        self.captured_request = request
+        return Response(200, request=request, content=self.body)
+
+
+@pytest.mark.asyncio
+async def test_stream_post_forces_identity_accept_encoding():
+    """A compressing proxy in front of an SSE endpoint will buffer the whole
+    stream to fill its gzip window, turning a live stream into silence
+    followed by one big burst. We must always ask for uncompressed output."""
+    transport = _CaptureTransport()
+    client = HTTPClient(client=AsyncClient(transport=transport, base_url="https://example.com"))
+
+    lines = [line async for line in client.stream_post("/chat", json={"a": 1}) if line]
+
+    assert lines == ['data: {"choices":[]}']
+    assert transport.captured_request is not None
+    assert transport.captured_request.headers["accept-encoding"] == "identity"
+
+
+@pytest.mark.asyncio
+async def test_stream_post_overrides_client_default_accept_encoding():
+    """Even if the AsyncClient itself sets a compressing Accept-Encoding by
+    default, stream_post must override it with identity."""
+    transport = _CaptureTransport()
+    client = HTTPClient(
+        client=AsyncClient(
+            transport=transport,
+            base_url="https://example.com",
+            headers={"Accept-Encoding": "gzip, deflate"},
+        )
+    )
+
+    async for _ in client.stream_post("/chat", json={"a": 1}):
+        pass
+
+    assert transport.captured_request.headers["accept-encoding"] == "identity"
+
+
+@pytest.mark.asyncio
+async def test_stream_post_preserves_other_headers():
+    transport = _CaptureTransport()
+    client = HTTPClient(client=AsyncClient(transport=transport, base_url="https://example.com"))
+
+    async for _ in client.stream_post("/chat", json={"a": 1}, headers={"X-Custom": "value"}):
+        pass
+
+    assert transport.captured_request.headers["x-custom"] == "value"
+    assert transport.captured_request.headers["accept-encoding"] == "identity"
