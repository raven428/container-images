+from ai_review.libs.llm.stream_logger import StreamSegmentLogger
+
+
+def _make():
+    answers: list[tuple[str, int, int]] = []
+    thinkings: list[tuple[str, int, int]] = []
+
+    def on_answer(piece: str, size: int, total: int) -> None:
+        answers.append((piece, size, total))
+
+    def on_thinking(piece: str, size: int, total: int) -> None:
+        thinkings.append((piece, size, total))
+
+    return answers, thinkings, on_answer, on_thinking
+
+
+def test_feed_without_tags_flushes_answer_by_threshold():
+    answers, thinkings, on_answer, on_thinking = _make()
+    sl = StreamSegmentLogger(5, on_answer, on_thinking)
+
+    # No '<' at all → the buffer can be flushed immediately, and every push
+    # that reaches the threshold triggers an emit.
+    sl.feed("hello")     # 5 chars → emit "hello"
+    sl.feed(" world")    # 6 chars → emit " world"
+    sl.feed("!!")        # 2 chars — under threshold, held until flush
+    sl.flush()
+
+    joined = "".join(p for p, _, _ in answers)
+    assert joined == "hello world!!"
+    assert thinkings == []
+
+
+def test_pending_lt_holds_back_potential_tag_prefix():
+    answers, thinkings, on_answer, on_thinking = _make()
+    sl = StreamSegmentLogger(1000, on_answer, on_thinking)
+
+    # "hi <" could be the start of "<think>"; the "<" tail must not leak into
+    # the answer channel prematurely — otherwise the tag itself would be
+    # split between "answer" and "thinking" channels.
+    sl.feed("hi <")
+    assert answers == []
+    # Feed the rest of the tag → routed to thinking channel.
+    sl.feed("think>reason</think>bye")
+    sl.flush()
+
+    assert "".join(p for p, _, _ in answers) == "hi bye"
+    assert "".join(p for p, _, _ in thinkings) == "reason"
+
+
+def test_lonely_lt_that_is_not_a_tag_is_still_emitted_on_flush():
+    answers, thinkings, on_answer, on_thinking = _make()
+    sl = StreamSegmentLogger(3, on_answer, on_thinking)
+
+    sl.feed("value < 5 is small")
+    sl.flush()
+
+    assert "".join(p for p, _, _ in answers) == "value < 5 is small"
+
+
+def test_thinking_block_is_routed_to_thinking_channel():
+    answers, thinkings, on_answer, on_thinking = _make()
+    sl = StreamSegmentLogger(4, on_answer, on_thinking)
+
+    sl.feed("hi <think>reasoning here</think>bye")
+    sl.flush()
+
+    assert "".join(p for p, _, _ in answers) == "hi bye"
+    assert "".join(p for p, _, _ in thinkings) == "reasoning here"
+
+
+def test_thinking_tag_can_be_uppercase_and_thinking_variant():
+    answers, thinkings, on_answer, on_thinking = _make()
+    sl = StreamSegmentLogger(4, on_answer, on_thinking)
+
+    sl.feed("A<THINKING>deep</THINKING>B<Think>more</Think>C")
+    sl.flush()
+
+    assert "".join(p for p, _, _ in answers) == "ABC"
+    assert "".join(p for p, _, _ in thinkings) == "deepmore"
+
+
+def test_open_tag_split_across_two_chunks_is_detected():
+    answers, thinkings, on_answer, on_thinking = _make()
+    sl = StreamSegmentLogger(3, on_answer, on_thinking)
+
+    sl.feed("start <thi")
+    sl.feed("nking>brain</thinking>end")
+    sl.flush()
+
+    assert "".join(p for p, _, _ in answers) == "start end"
+    assert "".join(p for p, _, _ in thinkings) == "brain"
+
+
+def test_close_tag_split_across_two_chunks_is_detected():
+    answers, thinkings, on_answer, on_thinking = _make()
+    sl = StreamSegmentLogger(3, on_answer, on_thinking)
+
+    sl.feed("<think>reason</thi")
+    sl.feed("nk>after")
+    sl.flush()
+
+    assert "".join(p for p, _, _ in answers) == "after"
+    assert "".join(p for p, _, _ in thinkings) == "reason"
+
+
+def test_flush_releases_remainder_that_never_reached_threshold():
+    answers, thinkings, on_answer, on_thinking = _make()
+    sl = StreamSegmentLogger(1000, on_answer, on_thinking)
+
+    sl.feed("x")
+    assert answers == []
+    sl.flush()
+
+    assert answers == [("x", 1, 1)]
+
+
+def test_running_totals_are_per_channel():
+    answers, thinkings, on_answer, on_thinking = _make()
+    sl = StreamSegmentLogger(2, on_answer, on_thinking)
+
+    sl.feed("aa<think>bb</think>cc<think>dd</think>ee")
+    sl.flush()
+
+    ans_totals = [t for _, _, t in answers]
+    think_totals = [t for _, _, t in thinkings]
+    # answers accumulate: aa (2), cc (2→4), ee (2→6)
+    assert ans_totals[-1] == 6
+    # thinkings accumulate: bb (2), dd (2→4)
+    assert think_totals[-1] == 4
+
+
+def test_unterminated_thinking_block_is_still_flushed_on_flush():
+    answers, thinkings, on_answer, on_thinking = _make()
+    sl = StreamSegmentLogger(4, on_answer, on_thinking)
+
+    sl.feed("intro <think>never closed…")
+    sl.flush()
+
+    assert "".join(p for p, _, _ in answers) == "intro "
+    assert "".join(p for p, _, _ in thinkings) == "never closed…"
+
+
+def test_empty_feed_is_noop():
+    answers, thinkings, on_answer, on_thinking = _make()
+    sl = StreamSegmentLogger(4, on_answer, on_thinking)
+
+    sl.feed("")
+    sl.flush()
+
+    assert answers == []
+    assert thinkings == []
+
+
+def test_feed_thinking_bypasses_tag_parsing():
+    """Reasoning field content goes straight to the thinking channel."""
+    answers, thinkings, on_answer, on_thinking = _make()
+    sl = StreamSegmentLogger(3, on_answer, on_thinking)
+
+    sl.feed_thinking("plain reasoning text ")
+    sl.feed_thinking("without any tags")
+    sl.flush()
+
+    assert answers == []
+    assert "".join(p for p, _, _ in thinkings) == "plain reasoning text without any tags"
+
+
+def test_pending_and_total_observability_helpers():
+    answers, thinkings, on_answer, on_thinking = _make()
+    sl = StreamSegmentLogger(10, on_answer, on_thinking)
+
+    sl.feed("hi")
+    assert sl.pending_answer_chars == 2
+    assert sl.answer_total == 0
+
+    sl.feed_thinking("thought")
+    assert sl.pending_thinking_chars == 7
+    assert sl.thinking_total == 0
+
+    sl.flush()
+    assert sl.answer_total == 2
+    assert sl.thinking_total == 7
+    assert sl.pending_answer_chars == 0
+    assert sl.pending_thinking_chars == 0
