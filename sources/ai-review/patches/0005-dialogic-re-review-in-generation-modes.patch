+def strip_ai_tags(body: str) -> str:
+    return _AI_TAGS_RE.sub("", body or "").strip()
+
+
+_INLINE_AI_TAGS_RE = re.compile(
+    r"#ai-review-(inline-reply|inline)",
+    re.IGNORECASE,
+)
+
+_SUMMARY_AI_TAGS_RE = re.compile(
+    r"#ai-review-(summary-reply|summary)",
+    re.IGNORECASE,
+)
+
+
+def _thread_has_human_reply(thread: ReviewThreadSchema) -> bool:
+    if not thread.comments:
+        return False
+    last_body = thread.comments[-1].body or ""
+    tag_re = (
+        _INLINE_AI_TAGS_RE
+        if thread.kind == ThreadKind.INLINE
+        else _SUMMARY_AI_TAGS_RE
+    )
+    return not bool(tag_re.search(last_body))
+
+
+def format_review_context(threads: list[ReviewThreadSchema]) -> str:
+    if not threads:
+        return "No existing discussion."
+
+    lines: list[str] = []
+    for thread in threads:
+        if not thread.comments:
+            continue
+        location = f"{thread.file}:{thread.line}" if thread.file else "general"
+        status = "human replied" if _thread_has_human_reply(thread) else "no human reply yet"
+        lines.append(f"### {location} [{status}]")
+        for comment in thread.comments:
+            user = (comment.author.name or comment.author.username or "User").strip()
+            body = strip_ai_tags(comment.body)
+            if not body:
+                continue
+            lines.append(f"- {user}: {body}")
+        lines.append("")
+
+    return "\n".join(lines).strip()
+
+
 def format_thread(thread: ReviewThreadSchema) -> str:
