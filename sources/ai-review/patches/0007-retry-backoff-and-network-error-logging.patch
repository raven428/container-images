@@ -0,0 +1,16 @@
+import httpx
+
+
+# All httpx exceptions that represent transient network-level failures:
+# connection refused/reset, DNS lookup failure, SSL handshake, timeouts, etc.
+# Using the base TransportError covers ConnectError, ReadError, WriteError,
+# CloseError, RemoteProtocolError, LocalProtocolError and all timeout variants.
+_NETWORK_ERRORS = (httpx.TransportError,)
+
+
+def is_network_error(error: BaseException) -> bool:
+  return isinstance(error, _NETWORK_ERRORS)
+
+
+def network_error_message(error: BaseException) -> str:
+  return f'{type(error).__name__}: {error}'
--- a/ai_review/libs/http/backoff.py
+++ b/ai_review/libs/http/backoff.py
@@ -0,0 +1,20 @@
+# Backoff schedule: delay grows by STEP_DELAY every 3 attempts, capped at
+# CAP_DELAY.  After 3 consecutive cap-level attempts the cycle resets to
+# INITIAL_DELAY.  This mirrors the algorithm from
+# opencode-ctrl/patches/common/retry-overload-cap.diff.
+_INITIAL_DELAY = 1.0   # seconds
+_STEP_DELAY = 1.0      # seconds added per 3-attempt block
+_CAP_DELAY = 11.0      # seconds — maximum single-attempt wait
+# Number of blocks to reach cap: ceil(CAP / STEP) = 11
+_CAP_BLOCKS = int(_CAP_DELAY / _STEP_DELAY)  # 11
+# Full reset cycle length: 11 rising blocks * 3 attempts + 3 cap attempts = 36
+_CYCLE = _CAP_BLOCKS * 3 + 3  # 36
+
+
+def backoff_delay(attempt: int) -> float:
+  """Return the sleep duration in seconds for the given attempt (0-indexed).
+
+  The schedule rises in 1-second steps every 3 attempts up to CAP_DELAY,
+  then resets — giving short bursts at each level before backing off further.
+  """
+  return min((attempt % _CYCLE // 3) * _STEP_DELAY + _INITIAL_DELAY, _CAP_DELAY)
