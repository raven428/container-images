 def test_resolve_prompt_files_returns_given_list(tmp_path: Path):
     dummy_file = tmp_path / "file.md"
+    dummy_file.write_text("DUMMY")
     result = resolve_prompt_files([dummy_file], "default_inline.md")
     assert result == [dummy_file]
 
 
+def test_resolve_prompt_files_fallback_to_package_default(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+):
+    dummy_default = tmp_path / "default_inline.md"
+    dummy_default.write_text("PKG_DEFAULT")
+    monkeypatch.setattr(
+        "ai_review.libs.config.prompt.load_resource", lambda **_: dummy_default
+    )
+    result = resolve_prompt_files(
+        [Path("./prompts/default_inline.md")], "default_inline.md"
+    )
+    assert result == [dummy_default]
+
+
+def test_resolve_prompt_files_mixed_existing_and_fallback(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+):
+    custom_file = tmp_path / "custom.md"
+    custom_file.write_text("CUSTOM")
+    pkg_default = tmp_path / "default_inline.md"
+    pkg_default.write_text("PKG")
+    monkeypatch.setattr(
+        "ai_review.libs.config.prompt.load_resource", lambda **_: pkg_default
+    )
+    result = resolve_prompt_files(
+        [Path("./prompts/default_inline.md"), custom_file], "default_inline.md"
+    )
+    assert result == [pkg_default, custom_file]
+
+
+def test_resolve_prompt_files_raises_on_missing_non_default(tmp_path: Path):
+    with pytest.raises(FileNotFoundError):
+        resolve_prompt_files(
+            [tmp_path / "totally_custom_missing.md"], "default_inline.md"
+        )
+
