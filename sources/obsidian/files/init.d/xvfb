#!/sbin/openrc-run
# cspell:ignore openrc Xvfb supervise nolisten

description="X Virtual Frame Buffer"

supervisor="supervise-daemon"
command="/usr/bin/Xvfb"
command_args=":99 -screen 0 ${SCREEN_WIDTH:-1920}x${SCREEN_HEIGHT:-1080}x\
${SCREEN_DEPTH:-24} -nolisten tcp"
respawn_delay=2
respawn_max=0

output_log="/run/svc.log"
error_log="/run/svc.log"

start_pre() {
  # kill existing Xvfb if running (avoids "already running" on respawn)
  pkill -x Xvfb 2>/dev/null || true
  sleep 1
  # clean stale X lock and socket from previous run
  rm -f /tmp/.X99-lock /tmp/.X11-unix/X99
  install -d -m 1777 /tmp/.X11-unix
  install -d -m 1777 /tmp/.ICE-unix
}

depend() {
  use net
}
