#!/sbin/openrc-run
# cspell:ignore openrc dbus supervise nopidfile

description="D-Bus system message bus"

supervisor="supervise-daemon"
command="/usr/bin/dbus-daemon"
command_args="--system --nofork --nopidfile --syslog-only \
  --address=unix:path=/run/dbus/system_bus_socket"
respawn_delay=2
respawn_max=0

output_log="/run/svc.log"
error_log="/run/svc.log"

start_pre() {
  install -d -m 755 /run/dbus
}

depend() {
  use net
}
