#!/sbin/openrc-run
# cspell:ignore openrc obsidian supervise sandbox

description="Obsidian note-taking app"

supervisor="supervise-daemon"
command="/usr/bin/obsidian"
command_args="--no-sandbox --disable-gpu-sandbox /vault"
command_user="obsidian"
respawn_delay=1

output_log="/run/svc.log"
error_log="/run/svc.log"

export DISPLAY=":99"
export HOME="/home/obsidian"
export XDG_CONFIG_HOME="/config"

depend() {
  need fluxbox
}
