#!/sbin/openrc-run
# cspell:ignore openrc novnc websockify supervise

description="noVNC websockify proxy"

supervisor="supervise-daemon"
command="/usr/bin/websockify"
command_args="--web /usr/share/novnc 6080 localhost:5900"
respawn_delay=1
respawn_max=0

output_log="/run/svc.log"
error_log="/run/svc.log"

depend() {
  need x11vnc
}
