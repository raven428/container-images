#!/sbin/openrc-run
# cspell:ignore openrc fluxbox supervise

description="Fluxbox window manager"

supervisor="supervise-daemon"
command="/usr/bin/fluxbox"
command_args="-display :99"
command_user="obsidian"
respawn_delay=1
respawn_max=0

output_log="/run/svc.log"
error_log="/run/svc.log"

export DISPLAY=":99"
export HOME="/home/obsidian"

depend() {
  need xvfb
}
