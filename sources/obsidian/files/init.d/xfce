#!/sbin/openrc-run
# cspell:ignore openrc xfce xfce4 supervise dbus dbus-run-session xfce4-session

description="XFCE4 desktop session"

supervisor="supervise-daemon"
command="/usr/bin/dbus-run-session"
command_args="-- /usr/bin/xfce4-session"
command_user="obsidian"
respawn_delay=3
respawn_max=0

output_log="/run/svc.log"
error_log="/run/svc.log"

export DISPLAY=":99"
export HOME="/home/obsidian"
export XDG_RUNTIME_DIR="/run/user/1000"
export XDG_CONFIG_HOME="/config"

start_pre() {
  # create XDG_RUNTIME_DIR owned by obsidian
  install -d -m 700 /run/user/1000
  chown obsidian:obsidian /run/user/1000
}

depend() {
  need xvfb dbus
}
