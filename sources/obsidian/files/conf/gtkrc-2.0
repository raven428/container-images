gtk-theme-name="Greymond-Rainy-Day"
gtk-icon-theme-name="Redmond97"
gtk-font-name="Sans 10"
gtk-cursor-theme-size=18
gtk-toolbar-style=GTK_TOOLBAR_BOTH
gtk-toolbar-icon-size=GTK_ICON_SIZE_BUTTON
gtk-button-images=1
gtk-menu-images=1
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle="hintslight"
gtk-xft-rgba="none"
